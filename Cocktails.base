filters:
  and:
    - file.folder == "Cocktails"
    - type == "cocktail"
formulas:
  Cocktail: link(file.name, file.name)
  AllInStock: ingredients.map(file(value).properties.in_stock).reduce(acc && value, true)
properties:
  formula.Cocktail:
    displayName: Cocktail
  note.name:
    displayName: Name
  note.description:
    displayName: Description
  note.ingredients:
    displayName: Ingredients
  formula.AllInStock:
    displayName: Available
views:
  - type: list
    name: Available
    filters:
      and:
        - formula.AllInStock == true
    sort:
      - property: formula.Cocktail
        direction: ASC
    order:
      - formula.Cocktail
      - description
    markers: bullet
    separator: " · "
  - type: list
    name: All
    sort:
      - property: formula.Cocktail
        direction: ASC
    order:
      - formula.Cocktail
      - description
    markers: bullet
    separator: " · "
